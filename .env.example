# Public application settings
NEXT_PUBLIC_APP_URL=https://newself.cc

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk JWT template named `convex`; use its issuer URL here and in Convex.
CLERK_JWT_ISSUER_DOMAIN=

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Cloudflare R2 (server only)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=newlook

# AI providers (server only)
AI_DEFAULT_PROVIDER=openai
GEMINI_API_KEY=
FAL_KEY=
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Product services
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
# Payment is intentionally deferred until a provider is selected.
PAYMENT_PROVIDER=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
